generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model Patient {
  id        String   @id @default(uuid())
  name      String
  age       Int
  gender    String
  ethnicity String
  ses       Int      @default(1)
  obsFreq   Int      @default(1)
  ivWeekend Boolean  @default(false)
  
  // Timestamps & Soft delete
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // Relations
  events            ClinicalEvent[]
  modelPredictions  ModelPrediction[]
  legalRecords      LegalRecord[]

  @@index([deletedAt])
}

enum VerificationStatus {
  DRAFT
  NEEDS_REVIEW
  VERIFIED
  REJECTED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model LegalRecord {
  id            String             @id @default(uuid())
  title         String
  description   String?
  documentType  String             @default("General Legal")
  jurisdiction  String             @default("US Federal")
  riskLevel     RiskLevel          @default(MEDIUM)
  patientId     String?
  status        VerificationStatus @default(DRAFT)
  reviewerNotes String?
  clauses       Json?
  detectedIssues Json?

  // Timestamps & Soft delete
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?

  // Relations
  patient       Patient?           @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([status])
  @@index([riskLevel])
  @@index([documentType])
  @@index([jurisdiction])
  @@index([deletedAt])
}


model ClinicalEvent {
  id        String   @id @default(uuid())
  patientId String
  eventType String   // e.g. "lab_test", "vital_sign", "medication"
  value     Float?
  timestamp DateTime
  
  // Timestamps & Soft delete
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  // Relations
  patient   Patient  @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([eventType])
  @@index([deletedAt])
}

model ModelPrediction {
  id          String   @id @default(uuid())
  patientId   String
  modelType   String   // e.g. "standard_ai", "iv_opil", "proxy_slcd"
  riskScore   Float
  details     Json?    // Stores conformal sets, embeddings, etc.
  
  // Timestamps & Soft delete
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  // Relations
  patient     Patient  @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([modelType])
  @@index([deletedAt])
}
